# Database Configuration (PostgreSQL sur Railway)
DATABASE_URL="postgresql://user:password@localhost/fintrack?serverVersion=15&charset=utf8"

# Application
APP_ENV=prod
APP_SECRET=CHANGE_THIS_TO_RANDOM_STRING_32_CHARS_MIN
SYMFONY_BASE_URL=https://your-app.railway.app

# Mailer (Gmail SMTP - même que local)
MAILER_DSN=smtp://ghaithbenaomr@gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:587?encryption=tls&auth_mode=login
MAIL_FROM=noreply@fintrack.app

# Messenger (utiliser async pour la file)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# API Keys (CONFIGURE DANS RAILWAY - NE PAS COMMITER)
# Allez dans Railway → Variables et ajoutez:
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=noreply@fintrack.app
BREVO_SENDER_NAME=FinTrack

BREVO_SMS_API_KEY=YOUR_BREVO_SMS_API_KEY_HERE
BREVO_SMS_SENDER=FinTrack

TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+15739430306

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
MODERATE_API_KEY=YOUR_MODERATE_API_KEY_HERE

# OAuth (Google, Facebook, GitHub)
